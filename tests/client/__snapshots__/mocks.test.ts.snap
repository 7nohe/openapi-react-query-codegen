exports[`emitMocks > the mock data and the handlers of a specification > handlers.ts 1`] = `
"// This file is auto-generated by @7nohe/openapi-react-query-codegen

/**
 * MSW request handlers for the API. Each answers with the mock of its
 * operation's successful response. Pass a handler another body, or a resolver
 * of your own, to answer with something else:
 *
 *   setupWorker(findPetsHandler([]), ...handlers)
 *
 * MSW uses the first handler that matches, so yours go before \`handlers\`.
 */

import {
  type HttpHandler,
  HttpResponse,
  type HttpResponseResolver,
  http,
} from "msw/http";
import type * as Types from "../requests/types.gen";
import * as mocks from "./data";

/** Answers with \`override\` when it is a body, and lets it answer when it is a resolver. */
const answer = <T>(
  override: T | HttpResponseResolver | undefined,
  mock: () => T,
  respond: (body: T) => Response,
): HttpResponseResolver =>
  typeof override === "function"
    ? (override as HttpResponseResolver)
    : () => respond(override === undefined ? mock() : (override as T));

const json = (status: number) => (body: unknown) =>
  HttpResponse.json(body as Parameters<typeof HttpResponse.json>[0], {
    status,
  });

const text = (status: number) => (body: unknown) =>
  HttpResponse.text(String(body), { status });

const empty =
  (status: number): HttpResponseResolver =>
  () =>
    new HttpResponse(null, { status });

export const listPetsHandler = (override?: Types.ListPetsResponses[200] | HttpResponseResolver) =>
  http.get(
    "*/pets",
    answer(override, mocks.listPetsResponseMock, json(200)),
  );

export const createPetHandler = (override?: Types.CreatePetResponses[201] | HttpResponseResolver) =>
  http.post(
    "*/pets",
    answer(override, mocks.createPetResponseMock, json(201)),
  );

export const headPetsHandler = (override?: HttpResponseResolver) =>
  http.head("*/pets", override ?? empty(200));

export const countPetsHandler = (override?: Types.CountPetsResponses[200] | HttpResponseResolver) =>
  http.get(
    new RegExp("/pets:count/?$"),
    answer(override, mocks.countPetsResponseMock, json(200)),
  );

export const listAnimalsHandler = (override?: Types.ListAnimalsResponses["default"] | HttpResponseResolver) =>
  http.get(
    "*/animals",
    answer(override, mocks.listAnimalsResponseMock, json(200)),
  );

export const getStatusHandler = (override?: Types.GetStatusResponses[200] | HttpResponseResolver) =>
  http.get(
    "*/status",
    answer(override, mocks.getStatusResponseMock, text(200)),
  );

export const exportPetsHandler = (override?: HttpResponseResolver) =>
  http.get("*/export", override ?? empty(200));

export const getAnythingHandler = (override?: HttpResponseResolver) =>
  http.get("*/anything", override ?? empty(200));

export const getNothingHandler = (override?: HttpResponseResolver) =>
  http.get("*/nothing", override ?? empty(200));

export const getRangedHandler = (override?: Types.GetRangedResponses[206] | HttpResponseResolver) =>
  http.get(
    "*/ranged",
    answer(override, mocks.getRangedResponseMock, json(206)),
  );

export const getImpossibleHandler = (override?: Types.GetImpossibleResponses[200] | HttpResponseResolver) =>
  http.get(
    "*/impossible",
    answer(override, mocks.getImpossibleResponseMock, json(200)),
  );

export const getShapesHandler = (override?: Types.GetShapesResponses[200] | HttpResponseResolver) =>
  http.get(
    "*/shapes",
    answer(override, mocks.getShapesResponseMock, json(200)),
  );

export const listMyPetsHandler = (override?: Types.ListMyPetsResponses["2XX"] | HttpResponseResolver) =>
  http.get(
    "*/pets/mine",
    answer(override, mocks.listMyPetsResponseMock, json(200)),
  );

export const archivePetHandler = (override?: HttpResponseResolver) =>
  http.delete(new RegExp("/pets/([^/]+):archive/?$"), override ?? empty(202));

export const getArchiveHandler = (override?: Types.GetArchiveResponses[200] | HttpResponseResolver) =>
  http.get(
    new RegExp("/archives/([^/]+)([^/]+)/?$"),
    answer(override, mocks.getArchiveResponseMock, json(200)),
  );

export const getFileHandler = (override?: Types.GetFileResponses[200] | HttpResponseResolver) =>
  http.get(
    new RegExp("/files/([^/]+)\\\\.\\\\(json\\\\|yaml\\\\)/$"),
    answer(override, mocks.getFileResponseMock, json(200)),
  );

export const getPetHandler = (override?: Types.GetPetResponses[200] | HttpResponseResolver) =>
  http.get(
    "*/pets/:pet_id",
    answer(override, mocks.getPetResponseMock, json(200)),
  );

export const deletePetHandler = (override?: HttpResponseResolver) =>
  http.delete("*/pets/:pet_id", override ?? empty(204));

export const getCafeHandler = (override?: Types.GetCafeResponses[200] | HttpResponseResolver) =>
  http.get(
    new RegExp("/caf%C3%A9/([^/]+)/?$"),
    answer(override, mocks.getCafeResponseMock, json(200)),
  );

export const getTagHandler = (override?: Types.GetTagResponses[200] | HttpResponseResolver) =>
  http.get(
    "*/tags/:_1st/",
    answer(override, mocks.getTagResponseMock, json(200)),
  );

export const pingBetaHandler = (override?: Types.PingBetaResponses[200] | HttpResponseResolver) =>
  http.get(
    new RegExp("/v([^/]+)beta/ping/?$"),
    answer(override, mocks.pingBetaResponseMock, json(200)),
  );

export const handlers: HttpHandler[] = [
  listPetsHandler(),
  createPetHandler(),
  headPetsHandler(),
  countPetsHandler(),
  listAnimalsHandler(),
  getStatusHandler(),
  exportPetsHandler(),
  getAnythingHandler(),
  getNothingHandler(),
  getRangedHandler(),
  getImpossibleHandler(),
  getShapesHandler(),
  listMyPetsHandler(),
  archivePetHandler(),
  getArchiveHandler(),
  getFileHandler(),
  getPetHandler(),
  deletePetHandler(),
  getCafeHandler(),
  getTagHandler(),
  pingBetaHandler(),
];
"
`;

