{
  "name": "@7nohe/react-router-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "run-p dev:mock dev:client",
    "dev:client": "react-router dev",
    "dev:mock": "node ../mock-server.mjs",
    "build": "pnpm typecheck && react-router build",
    "preview": "react-router-serve ./build/server/index.js",
    "typegen": "react-router typegen",
    "typecheck": "pnpm typegen && tsc",
    "generate:api": "node ../../scripts/clean.mjs ./openapi && node ../../dist/cli.mjs -i ../petstore.yaml --format=biome --lint=biome",
    "test:generated": "pnpm typegen && tsc -p ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tanstack/react-query": "^5.59.13",
    "@tanstack/react-query-devtools": "^5.32.1",
    "form-data": "~4.0.0",
    "isbot": "^5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@react-router/dev": "^8.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "^5.4.5",
    "vite": "^8.3.6"
  }
}
