{
  "name": "@7nohe/react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "run-p dev:mock dev:client",
    "dev:client": "vite --clearScreen=false",
    "dev:mock": "node ../mock-server.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate:api": "node ../../scripts/clean.mjs ./openapi && node ../../dist/cli.mjs -i ../petstore.yaml --format=biome --lint=biome -c axios",
    "test:generated": "tsc -p ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.13",
    "@tanstack/react-query-devtools": "^5.32.1",
    "axios": "^1.7.7",
    "form-data": "~4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "^5.4.5",
    "vite": "^8.3.6"
  }
}
