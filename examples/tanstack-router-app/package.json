{
  "name": "tanstack-router-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:mock dev:tanstack",
    "dev:mock": "node ../mock-server.mjs",
    "typecheck": "tsc --noEmit",
    "dev:tanstack": "vite --port=3001",
    "build": "vite build",
    "serve": "vite preview",
    "start": "vite",
    "generate:api": "node ../../scripts/clean.mjs ./openapi && node ../../dist/cli.mjs -i ../petstore.yaml --format=biome --lint=biome",
    "test:generated": "tsc -p ./tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.48",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "npm-run-all2": "^9.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.13",
    "@tanstack/react-query-devtools": "^5.32.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/router-devtools": "^1.167.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
