{
  "name": "@7nohe/openapi-react-query-codegen",
  "version": "4.0.0-beta.7",
  "description": "Generate TanStack Query (React Query) hooks, queryOptions factories and a typed fetch/axios client from your OpenAPI spec",
  "bin": {
    "orqc": "dist/cli.mjs",
    "openapi-rq": "dist/cli.mjs",
    "openapi-react-query-codegen": "dist/cli.mjs"
  },
  "private": false,
  "type": "module",
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "preview:react": "npm run build && npm -C examples/react-app run generate:api",
    "preview:nextjs": "npm run build && npm -C examples/nextjs-app run generate:api",
    "preview:tanstack-router": "npm run build && npm -C examples/tanstack-router-app run generate:api",
    "prepublishOnly": "npm run build",
    "release": "npx git-ensure -a && npx bumpp --commit --tag --push",
    "test": "vitest --coverage.enabled true",
    "snapshot": "vitest --update"
  },
  "exports": [
    {
      "import": "./dist/generate.mjs",
      "require": "./dist/generate.mjs",
      "types": "./dist/generate.d.mts"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7nohe/openapi-react-query-codegen.git"
  },
  "homepage": "https://orqc.7nohe.dev",
  "bugs": "https://github.com/7nohe/openapi-react-query-codegen/issues",
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "keywords": [
    "openapi",
    "openapi3",
    "swagger",
    "codegen",
    "code-generator",
    "tanstack-query",
    "react-query",
    "react",
    "hooks",
    "typescript",
    "fetch",
    "axios",
    "orqc"
  ],
  "license": "MIT",
  "author": "Daiki Urata (@7nohe)",
  "dependencies": {
    "cross-spawn": "^7.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axios": "1.20.0",
    "commander": "^15.1.0",
    "lefthook": "^2.1.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "commander": "12.x || 13.x || 14.x || 15.x"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@babel/helpers": "7.26.10",
      "@babel/runtime": "7.26.10",
      "@tootallnate/once": "2.0.1",
      "ajv": "8.18.0",
      "axios": "1.20.0",
      "body-parser@1": "1.20.9",
      "cross-spawn@6": "6.0.6",
      "cross-spawn@7": "7.0.6",
      "devalue": "5.9.4",
      "diff@4": "4.0.4",
      "diff@5": "5.2.2",
      "fast-xml-parser": "5.12.0",
      "follow-redirects": "1.16.2",
      "form-data": "4.0.6",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "jsonpath-plus": "10.3.0",
      "lodash": "4.18.0",
      "mdast-util-to-hast": "13.2.1",
      "micromatch": "4.0.8",
      "morgan": "1.12.1",
      "on-headers": "1.1.0",
      "path-to-regexp@0": "0.1.13",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.7",
      "postcss": "8.5.23",
      "prismjs": "1.30.0",
      "qs": "6.16.1",
      "rollup": "4.59.0",
      "shell-quote": "1.11.0",
      "tar-fs@2": "2.1.4",
      "tar-fs@3": "3.1.1",
      "tsx": "4.23.12",
      "undici@6": "6.29.1",
      "uuid": "11.1.1",
      "yaml@1": "1.10.3",
      "yaml@2": "2.9.1"
    }
  }
}
