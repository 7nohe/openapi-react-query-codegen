import { existsSync } from "node:fs";
import { readFile, writeFile } from "node:fs/promises";
import path from "node:path";
import type { FileChange } from "./check.mjs";
import { queriesOutputPath, requestsOutputPath } from "./constants.mjs";

/** Where `--agentsMd` writes when it is given no file name. */
export const defaultAgentsFile = "AGENTS.md";

/** The file `--agentsMd` names: the option is `true` without a value. */
export function agentsFilePath(option: string | boolean): string {
  return typeof option === "string" && option !== ""
    ? option
    : defaultAgentsFile;
}

/** The output directory as an agent working in cwd would write it. */
function displayPath(output: string): string {
  const relative = path.relative(process.cwd(), path.resolve(output));
  const inside =
    relative !== "" && !relative.startsWith("..") && !path.isAbsolute(relative);
  return (inside ? relative : output).split(path.sep).join("/");
}

const begin = (output: string) => `<!-- openapi-rq:begin ${output} -->`;
const end = (output: string) => `<!-- openapi-rq:end ${output} -->`;

/**
 * What a coding agent needs to use the generated client without reading its
 * files, which are far too large for that: how the names are built, and how to
 * find an operation and its types with `grep`.
 *
 * The block sits between two comments that carry the output path, so that it
 * can be found again and replaced, and a project with two generated clients
 * gets one block for each.
 */
export function renderAgentsBlock(output: string): string {
  const out = displayPath(output);
  const sdk = `${out}/${requestsOutputPath}/sdk.gen.ts`;
  const types = `${out}/${requestsOutputPath}/types.gen.ts`;
  return `${begin(out)}
## Generated API client (\`${out}\`)

\`${out}\` is generated by \`openapi-rq\` (\`@7nohe/openapi-react-query-codegen\`) from the OpenAPI document. Do not edit it: change the document or the flags and generate again. Its files can be very large, so look things up as described here instead of reading them.

### Names

For an operation whose function is \`findPets\` (a GET) or \`addPet\` (any other method):

- \`${queriesOutputPath}/queries.ts\`: \`useFindPets(clientOptions?, queryKey?, options?)\` (useQuery) and \`useAddPet(mutationKey?, options?)\` (useMutation, called as \`mutate(clientOptions)\`)
- \`${queriesOutputPath}/suspense.ts\`: \`useFindPetsSuspense\`. \`${queriesOutputPath}/queryOptions.ts\`: \`findPetsOptions\`. \`${queriesOutputPath}/prefetch.ts\`: \`prefetchUseFindPets\`. \`${queriesOutputPath}/ensureQueryData.ts\`: \`ensureUseFindPetsData\`
- \`${queriesOutputPath}/common.ts\`: \`useFindPetsKey\` and \`UseFindPetsKeyFn(clientOptions?)\`, for \`invalidateQueries\`
- Import them from \`${out}/${queriesOutputPath}\`. \`clientOptions\` is \`{ path, query, body, headers }\`.

### Finding an operation

- By a word in its name: \`grep -o '^export const [A-Za-z0-9_]*' ${sdk} | grep -i pet\`
- By URL path: \`grep -B7 'url: "/pets/{petId}"' ${sdk} | grep -o 'export const [A-Za-z0-9_]*'\`. The function is the last name before each match.

### What an operation takes and returns

- \`grep -n -A30 '^export type FindPetsData = ' ${types}\`: \`path\`, \`query\` and \`body\`
- \`grep -n -A12 '^export type FindPetsResponses = ' ${types}\`: the response for each status
- A schema one of them names: \`grep -n -A40 '^export type Pet = ' ${types}\`
${end(out)}
`;
}

/**
 * Put the block into the content of an instructions file: in place of the
 * block that is there for the same output, or else at the end.
 */
export function applyAgentsBlock(
  existing: string | undefined,
  block: string,
): string {
  if (existing === undefined || existing.trim() === "") return block;
  const [first] = block.split("\n");
  const last = first.replace("openapi-rq:begin", "openapi-rq:end");
  const from = existing.indexOf(first);
  const to = existing.indexOf(last, from);
  if (from === -1 || to === -1) {
    return `${existing.replace(/\n*$/, "\n\n")}${block}`;
  }
  const after = existing.slice(to + last.length).replace(/^\n/, "");
  return `${existing.slice(0, from)}${block}${after}`;
}

async function readIfPresent(file: string): Promise<string | undefined> {
  return existsSync(file) ? readFile(file, "utf8") : undefined;
}

/** Write or refresh the block for `output` in `file`. */
export async function writeAgentsBlock(
  file: string,
  output: string,
): Promise<void> {
  const existing = await readIfPresent(file);
  const updated = applyAgentsBlock(existing, renderAgentsBlock(output));
  if (updated !== existing) {
    await writeFile(file, updated);
  }
}

/** What `--check` reports for the block, if it is missing or out of date. */
export async function checkAgentsBlock(
  file: string,
  output: string,
): Promise<FileChange | undefined> {
  const existing = await readIfPresent(file);
  const block = renderAgentsBlock(output);
  if (existing?.includes(block)) return undefined;
  const reported = file.split(path.sep).join("/");
  return {
    path: reported,
    status: existing?.includes(block.split("\n")[0]) ? "modified" : "added",
  };
}

/**
 * Claude Code reads `AGENTS.md` only where there is no `CLAUDE.md`. When the
 * block goes into an `AGENTS.md` next to a `CLAUDE.md` that does not import
 * it, say how to make the block reach Claude Code as well.
 */
export async function claudeImportHint(
  file: string,
): Promise<string | undefined> {
  if (path.basename(file) !== defaultAgentsFile) return undefined;
  const claude = path.join(path.dirname(file), "CLAUDE.md");
  const content = await readIfPresent(claude);
  if (content === undefined || content.includes(defaultAgentsFile)) {
    return undefined;
  }
  return `${claude} does not mention ${defaultAgentsFile}, so Claude Code will not read the block. Add a line \`@${defaultAgentsFile}\` to ${claude}, or pass --agentsMd CLAUDE.md.`;
}
