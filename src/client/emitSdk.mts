import {
  type BodyKind,
  classifyResponses,
  type OperationIR,
  type ParameterIR,
  type SecurityIR,
} from "./operations.mjs";
import { componentSchemaKey, docComment } from "./schema.mjs";
import { type Doc, getByPointer, type Json } from "./spec.mjs";

export type ClientKind = "fetch" | "axios";

const HEADER =
  "// This file is auto-generated by @7nohe/openapi-react-query-codegen\n";

const CONTENT_TYPE_BY_KIND: Partial<Record<BodyKind, string>> = {
  urlencoded: "application/x-www-form-urlencoded",
};

function q(value: string): string {
  return JSON.stringify(value);
}

function resolveSchema(doc: Doc, schema: Json, depth = 0): Json {
  if (!schema || typeof schema !== "object" || depth > 16) return schema;
  if (typeof schema.$ref === "string") {
    const key = componentSchemaKey(schema.$ref);
    const target =
      key !== undefined
        ? doc.components?.schemas?.[key]
        : getByPointer(doc, schema.$ref);
    return resolveSchema(doc, target, depth + 1);
  }
  return schema;
}

function schemaType(doc: Doc, schema: Json): string | undefined {
  const resolved = resolveSchema(doc, schema);
  if (!resolved || typeof resolved !== "object") return undefined;
  const type = Array.isArray(resolved.type)
    ? resolved.type.find((item: string) => item !== "null")
    : resolved.type;
  if (type) return type;
  if (resolved.properties) return "object";
  if (resolved.items) return "array";
  return undefined;
}

/** Query parameters whose OpenAPI style differs from the runtime defaults. */
function querySerializerEntries(doc: Doc, parameters: ParameterIR[]): string[] {
  const entries: string[] = [];
  for (const parameter of parameters) {
    if (parameter.in !== "query") continue;
    const type = schemaType(doc, parameter.schema);
    const style = parameter.style;
    if (type === "array") {
      const explode = parameter.explode ?? true;
      const isDefault = (style === undefined || style === "form") && explode;
      if (isDefault) continue;
      const arrayStyle =
        style === "spaceDelimited" || style === "pipeDelimited"
          ? style
          : "form";
      entries.push(
        `${q(parameter.name)}: { array: { style: ${q(arrayStyle)}, explode: ${explode} } }`,
      );
    } else if (type === "object" && style === "form") {
      entries.push(
        `${q(parameter.name)}: { object: { style: "form", explode: ${parameter.explode ?? true} } }`,
      );
    }
  }
  return entries;
}

function securityLiteral(security: SecurityIR): string {
  if (security.type === "apiKey") {
    return `{ in: ${q(security.in ?? "header")}, name: ${q(security.name ?? "")}, type: "apiKey" }`;
  }
  const scheme = security.scheme === "basic" ? "basic" : "bearer";
  return `{ scheme: ${q(scheme)}, type: "http" }`;
}

function parseAsFor(operation: OperationIR): string | undefined {
  const success = operation.responses.find(
    (response) => /^[23]/.test(response.status) && response.mediaType,
  );
  if (!success?.mediaType) return undefined;
  const type = success.mediaType.toLowerCase().split(";")[0].trim();
  if (type === "application/json" || type.endsWith("+json")) return "json";
  if (type.startsWith("text/")) return "text";
  if (type === "multipart/form-data") return "formData";
  return "blob";
}

export function optionsAreOptional(operation: OperationIR): boolean {
  if (operation.body?.required) return false;
  return !operation.parameters.some(
    (parameter) => parameter.required && parameter.in !== "cookie",
  );
}

function emitOperation(
  operation: OperationIR,
  doc: Doc,
  kind: ClientKind,
): { code: string; usedTypes: string[] } {
  const names = operation.typeNames;
  const { responses, errors } = classifyResponses(operation);
  const dataType = names.data;
  const responsesType = responses.length > 0 ? names.responses : "unknown";
  const errorsType = errors.length > 0 ? names.errors : "unknown";
  const usedTypes = [dataType];
  if (responses.length > 0) usedTypes.push(responsesType);
  if (errors.length > 0) usedTypes.push(errorsType);

  const optional = optionsAreOptional(operation);
  const optionsRef = optional ? "options?" : "options";
  const clientRef = optional
    ? "(options?.client ?? client)"
    : "(options.client ?? client)";
  const headersSpread = optional ? "...options?.headers" : "...options.headers";

  const lines: string[] = [];
  const parseAs = parseAsFor(operation);
  if (parseAs) {
    lines.push(
      kind === "axios"
        ? `responseType: ${q(parseAs === "formData" ? "json" : parseAs)}`
        : `parseAs: ${q(parseAs)}`,
    );
  }

  const security = operation.security.map(securityLiteral);
  if (security.length > 0) lines.push(`security: [${security.join(", ")}]`);

  const queryEntries = querySerializerEntries(doc, operation.parameters);
  if (queryEntries.length > 0 && kind === "fetch") {
    lines.push(
      `querySerializer: { parameters: { ${queryEntries.join(", ")} } }`,
    );
  }

  lines.push(`url: ${q(operation.path)}`);
  lines.push("...options");

  if (operation.body) {
    const { kind: bodyKind, mediaType } = operation.body;
    if (bodyKind === "form-data") {
      lines.splice(lines.length - 1, 0, 'bodyType: "form-data"');
      // The runtime sets the multipart boundary itself.
    } else {
      if (bodyKind === "json") {
        lines.splice(lines.length - 1, 0, 'bodyType: "json"');
      } else if (bodyKind === "urlencoded") {
        lines.splice(lines.length - 1, 0, 'bodyType: "urlencoded"');
      }
      const contentType = CONTENT_TYPE_BY_KIND[bodyKind] ?? mediaType;
      lines.push(
        `headers: {\n    "Content-Type": ${q(contentType)},\n    ${headersSpread}\n  }`,
      );
    }
  }

  const body = lines
    .map((line, index) => `  ${line}${index < lines.length - 1 ? "," : ""}`)
    .join("\n");
  const doc2 = operation.jsDoc ? `${operation.jsDoc}\n` : "";
  const generics = `<${responsesType}, ${errorsType}, ThrowOnError>`;
  const code = `${doc2}export const ${operation.functionName} = <ThrowOnError extends boolean = false>(${optionsRef}: Options<${dataType}, ThrowOnError>): RequestResult<${responsesType}, ${errorsType}, ThrowOnError> => ${clientRef}.${operation.method}${generics}({\n${body}\n});`;
  return { code, usedTypes };
}

export function emitSdk(
  doc: Doc,
  operations: OperationIR[],
  options: { kind: ClientKind; ext: string },
): string {
  const used = new Set<string>();
  const blocks: string[] = [];
  for (const operation of operations) {
    const { code, usedTypes } = emitOperation(operation, doc, options.kind);
    for (const type of usedTypes) if (type !== "unknown") used.add(type);
    blocks.push(code);
  }
  const typeImports = [...used].sort().join(", ");
  const imports = [
    `import { client } from "./client.gen${options.ext}";`,
    `import type { Client, Options as Options2, RequestResult, TDataShape } from "./runtime.gen${options.ext}";`,
  ];
  if (typeImports) {
    imports.push(
      `import type { ${typeImports} } from "./types.gen${options.ext}";`,
    );
  }

  const optionsType = `export type Options<
  TData extends TDataShape = TDataShape,
  ThrowOnError extends boolean = boolean,
> = Options2<TData, ThrowOnError> & {
${docComment({ description: "You can provide a client instance returned by `createClient()` instead of\nindividual options. This might be also useful if you want to implement a\ncustom client." }, "  ")}  client?: Client;
${docComment({ description: "You can pass arbitrary values through the `meta` object. This can be\nused to access values that aren't defined as part of the SDK function." }, "  ")}  meta?: Record<string, unknown>;
};`;

  return `${HEADER}\n${imports.join("\n")}\n\n${optionsType}\n\n${blocks.join("\n\n")}\n`;
}

export function emitClientFile(options: {
  kind: ClientKind;
  ext: string;
  baseUrl?: string;
}): string {
  const baseUrlKey = options.kind === "axios" ? "baseURL" : "baseUrl";
  const config = options.baseUrl
    ? `{ ${baseUrlKey}: ${q(options.baseUrl)} }`
    : "";
  return `${HEADER}
import {
  type ClientOptions,
  type Config,
  createClient,
  createConfig,
} from "./runtime.gen${options.ext}";
import type { ClientOptions as ClientOptions2 } from "./types.gen${options.ext}";

${docComment({
  description:
    "The `createClientConfig()` function will be called on client initialization\nand the returned object will become the client's initial configuration.\n\nYou may want to initialize your client this way instead of calling\n`setConfig()`. This is useful for example if you're using Next.js\nto ensure your client always has the correct values.",
})}export type CreateClientConfig<T extends ClientOptions = ClientOptions2> = (
  override?: Config<ClientOptions & T>,
) => Config<Required<ClientOptions> & T>;

export const client = createClient(createConfig<ClientOptions2>(${config}));
`;
}

export function emitIndexFile(ext: string): string {
  return `${HEADER}\nexport * from "./sdk.gen${ext}";\nexport * from "./types.gen${ext}";\n`;
}

export function emitServicesShim(ext: string): string {
  return `// This file is auto-generated for backward compatibility\nexport * from "./client.gen${ext}";\nexport * from "./sdk.gen${ext}";\n`;
}
