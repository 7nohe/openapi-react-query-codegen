import {
  type BodyKind,
  classifyResponses,
  mediaKind,
  type OperationIR,
  type ParameterIR,
  type SecurityIR,
} from "./operations.mjs";
import { docComment } from "./schema.mjs";
import { type Doc, type Json, resolveRef } from "./spec.mjs";

export type ClientKind = "fetch" | "axios";

export const HEADER =
  "// This file is auto-generated by @7nohe/openapi-react-query-codegen\n";

const CONTENT_TYPE_BY_KIND: Partial<Record<BodyKind, string>> = {
  urlencoded: "application/x-www-form-urlencoded",
};

function q(value: string): string {
  return JSON.stringify(value);
}

function schemaType(doc: Doc, schema: Json): string | undefined {
  const resolved = resolveRef(doc, schema);
  if (!resolved || typeof resolved !== "object") return undefined;
  if (Array.isArray(resolved.type)) {
    const types: string[] = resolved.type.filter(
      (item: string) => item !== "null",
    );
    // Alternatives of different shapes have no one type to go by.
    return types.length > 1 && !types.every((item) => PRIMITIVE_TYPES.has(item))
      ? undefined
      : types[0];
  }
  if (resolved.type) return resolved.type;
  if (resolved.properties) return "object";
  if (resolved.items) return "array";
  return undefined;
}

const PRIMITIVE_TYPES = new Set(["boolean", "integer", "number", "string"]);

/**
 * Query parameters the runtime defaults would serialize differently from the
 * OpenAPI ones. The runtime leaves arrays in `form` style with `explode`, and
 * objects in `deepObject` style, so only the rest is spelled out. OpenAPI
 * defaults a query parameter to `form`, and `explode` to true for `form` only.
 */
function querySerializerEntries(doc: Doc, parameters: ParameterIR[]): string[] {
  const entries: string[] = [];
  for (const parameter of parameters) {
    if (parameter.in !== "query") continue;
    if (parameter.json) {
      entries.push(`${q(parameter.name)}: { json: true }`);
      continue;
    }
    const type = schemaType(doc, parameter.schema);
    if (type !== undefined && PRIMITIVE_TYPES.has(type)) continue;
    const style = parameter.style ?? "form";
    const explode = parameter.explode ?? style === "form";
    if (style === "deepObject") continue;
    // A schema without a plain type (`anyOf`, say) can hold either shape.
    const settings: string[] = [];
    if (type !== "object" && !(style === "form" && explode)) {
      settings.push(`array: { style: ${q(style)}, explode: ${explode} }`);
    }
    if (type !== "array") {
      settings.push(`object: { style: "form", explode: ${explode} }`);
    }
    if (settings.length > 0) {
      entries.push(`${q(parameter.name)}: { ${settings.join(", ")} }`);
    }
  }
  return entries;
}

/** Path parameters that are not in the default `simple` style. */
function pathSerializerEntries(doc: Doc, parameters: ParameterIR[]): string[] {
  const entries: string[] = [];
  for (const parameter of parameters) {
    if (parameter.in !== "path") continue;
    if (parameter.json) {
      entries.push(`${q(parameter.name)}: { json: true }`);
      continue;
    }
    const style =
      parameter.style === "label" || parameter.style === "matrix"
        ? parameter.style
        : "simple";
    const explode = parameter.explode ?? false;
    if (style === "simple") {
      // `explode` only changes how an object is written.
      const type = schemaType(doc, parameter.schema);
      if (!explode || type === "array" || PRIMITIVE_TYPES.has(type ?? "")) {
        continue;
      }
    }
    entries.push(
      `${q(parameter.name)}: { style: ${q(style)}, explode: ${explode} }`,
    );
  }
  return entries;
}

function securityLiteral(security: SecurityIR): string {
  const key = security.key ? `key: ${q(security.key)}, ` : "";
  if (security.type === "apiKey") {
    return `{ in: ${q(security.in ?? "header")}, ${key}name: ${q(security.name ?? "")}, type: "apiKey" }`;
  }
  const scheme = security.scheme === "basic" ? "basic" : "bearer";
  return `{ ${key}scheme: ${q(scheme)}, type: "http" }`;
}

/** One alternative: a scheme, or the array of schemes it needs together. */
function securityRequirementLiteral(requirement: SecurityIR[]): string {
  const literals = requirement.map(securityLiteral);
  return literals.length === 1 ? literals[0] : `[${literals.join(", ")}]`;
}

function parseKind(mediaType: string): string {
  const kind = mediaKind(mediaType);
  if (kind === "json" || kind === "text") return kind;
  if (kind === "form-data") return "formData";
  // Readable documents, the same as the runtime when it detects the type.
  const type = mediaType.toLowerCase().split(";")[0].trim();
  return type === "application/xml" || type.endsWith("+xml") ? "text" : "blob";
}

/**
 * How to read a successful response, when every body the operation can answer
 * with is read the same way. With a mix (`200` JSON and `202` text, say) the
 * runtime has to look at the response itself.
 */
function parseAsFor(operation: OperationIR): string | undefined {
  const kinds = new Set(
    operation.responses
      .filter((response) => /^2/.test(response.status))
      .flatMap((response) => response.mediaTypes.map(parseKind)),
  );
  return kinds.size === 1 ? [...kinds][0] : undefined;
}

export function optionsAreOptional(operation: OperationIR): boolean {
  if (operation.body?.required) return false;
  return !operation.parameters.some((parameter) => parameter.required);
}

function emitOperation(
  operation: OperationIR,
  doc: Doc,
  kind: ClientKind,
  transformer: string | undefined,
): { code: string; usedTypes: string[] } {
  const names = operation.typeNames;
  const { responses, errors } = classifyResponses(operation);
  const dataType = names.data;
  const responsesType = responses.length > 0 ? names.responses : "unknown";
  const errorsType = errors.length > 0 ? names.errors : "unknown";
  const usedTypes = [dataType];
  if (responses.length > 0) usedTypes.push(responsesType);
  if (errors.length > 0) usedTypes.push(errorsType);

  const optional = optionsAreOptional(operation);
  const access = optional ? "options?" : "options";

  const lines: string[] = [];
  if (transformer) lines.push(`responseTransformer: ${transformer}`);
  // Axios has to know before the response arrives. The fetch runtime follows
  // the response's own Content-Type, or what the client is configured to do.
  const parseAs = kind === "axios" ? parseAsFor(operation) : undefined;
  if (parseAs) {
    lines.push(`responseType: ${q(parseAs === "formData" ? "json" : parseAs)}`);
  }

  const security = operation.security.map(securityRequirementLiteral);
  if (security.length > 0) lines.push(`security: [${security.join(", ")}]`);

  const queryEntries = querySerializerEntries(doc, operation.parameters);
  if (queryEntries.length > 0) {
    lines.push(
      `querySerializer: { parameters: { ${queryEntries.join(", ")} } }`,
    );
  }

  const pathEntries = pathSerializerEntries(doc, operation.parameters);
  if (pathEntries.length > 0) {
    lines.push(`pathSerializer: { parameters: { ${pathEntries.join(", ")} } }`);
  }

  const jsonHeaders = operation.parameters
    .filter((parameter) => parameter.in === "header" && parameter.json)
    .map((parameter) => q(parameter.name));
  if (jsonHeaders.length > 0) {
    lines.push(`jsonHeaders: [${jsonHeaders.join(", ")}]`);
  }

  lines.push(`url: ${q(operation.path)}`);
  const bodyKind = operation.body?.kind;
  if (
    bodyKind === "json" ||
    bodyKind === "form-data" ||
    bodyKind === "urlencoded"
  ) {
    lines.push(`bodyType: ${q(bodyKind)}`);
  }
  lines.push("...options");
  if (operation.body) {
    // Multipart clears any configured value: the boundary has to come from the
    // platform, which only adds the header when there is none.
    const contentType =
      bodyKind === "form-data"
        ? "null"
        : q(
            CONTENT_TYPE_BY_KIND[operation.body.kind] ??
              operation.body.mediaType,
          );
    lines.push(
      `headers: {\n    "Content-Type": ${contentType},\n    ...${access}.headers\n  }`,
    );
  }

  const body = lines
    .map((line, index) => `  ${line}${index < lines.length - 1 ? "," : ""}`)
    .join("\n");
  const doc2 = operation.jsDoc ? `${operation.jsDoc}\n` : "";
  const generics = `<${responsesType}, ${errorsType}, ThrowOnError>`;
  const code = `${doc2}export const ${operation.functionName} = <ThrowOnError extends boolean = false>(${optional ? "options?" : "options"}: Options<${dataType}, ThrowOnError>): RequestResult<${responsesType}, ${errorsType}, ThrowOnError> => (${access}.client ?? client).${operation.method}${generics}({\n${body}\n});`;
  return { code, usedTypes };
}

export function emitSdk(
  doc: Doc,
  operations: OperationIR[],
  options: {
    kind: ClientKind;
    ext: string;
    /** SDK function name → response transformer from `transformers.gen.ts`. */
    transformers?: ReadonlyMap<string, string>;
  },
): string {
  const used = new Set<string>();
  const blocks: string[] = [];
  for (const operation of operations) {
    const { code, usedTypes } = emitOperation(
      operation,
      doc,
      options.kind,
      options.transformers?.get(operation.functionName),
    );
    for (const type of usedTypes) used.add(type);
    blocks.push(code);
  }
  const typeImports = [...used].sort().join(", ");
  const imports = [
    `import { client } from "./client.gen${options.ext}";`,
    `import type { Client, Options as Options2, RequestResult, TDataShape } from "./runtime.gen${options.ext}";`,
  ];
  const transformers = [...(options.transformers?.values() ?? [])].sort();
  if (transformers.length > 0) {
    imports.push(
      `import { ${transformers.join(", ")} } from "./transformers.gen${options.ext}";`,
    );
  }
  if (typeImports) {
    imports.push(
      `import type { ${typeImports} } from "./types.gen${options.ext}";`,
    );
  }

  const optionsType = `export type Options<
  TData extends TDataShape = TDataShape,
  ThrowOnError extends boolean = boolean,
> = Options2<TData, ThrowOnError> & {
${docComment({ description: "You can provide a client instance returned by `createClient()` instead of\nindividual options. This might be also useful if you want to implement a\ncustom client." }, "  ")}  client?: Client;
${docComment({ description: "You can pass arbitrary values through the `meta` object. This can be\nused to access values that aren't defined as part of the SDK function." }, "  ")}  meta?: Record<string, unknown>;
};`;

  return `${HEADER}\n${imports.join("\n")}\n\n${optionsType}\n\n${blocks.join("\n\n")}\n`;
}

export function emitClientFile(options: {
  kind: ClientKind;
  ext: string;
  baseUrl?: string;
}): string {
  const baseUrlKey = options.kind === "axios" ? "baseURL" : "baseUrl";
  const config = options.baseUrl
    ? `{ ${baseUrlKey}: ${q(options.baseUrl)} }`
    : "";
  return `${HEADER}
import {
  type ClientOptions,
  type Config,
  createClient,
  createConfig,
} from "./runtime.gen${options.ext}";
import type { ClientOptions as ClientOptions2 } from "./types.gen${options.ext}";

${docComment({
  description:
    "The `createClientConfig()` function will be called on client initialization\nand the returned object will become the client's initial configuration.\n\nYou may want to initialize your client this way instead of calling\n`setConfig()`. This is useful for example if you're using Next.js\nto ensure your client always has the correct values.",
})}export type CreateClientConfig<T extends ClientOptions = ClientOptions2> = (
  override?: Config<ClientOptions & T>,
) => Config<Required<ClientOptions> & T>;

export const client = createClient(createConfig<ClientOptions2>(${config}));
`;
}

export function emitIndexFile(ext: string): string {
  return `${HEADER}\nexport * from "./sdk.gen${ext}";\nexport * from "./types.gen${ext}";\n`;
}

export function emitServicesShim(ext: string): string {
  return `// This file is auto-generated for backward compatibility\nexport * from "./client.gen${ext}";\nexport * from "./sdk.gen${ext}";\n`;
}
