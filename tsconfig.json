{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "rootDir": "src",
    "declaration": true
  },
  "include": ["src"]
}
